---
/**
 * Spanish lot pages, at `/lote/<slug>/`. The template is <LotPage>, shared
 * with the English route; this file only supplies the paths and the locale.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import LotPage from '../../components/LotPage.astro';

export const getStaticPaths = (async () => {
  const lots = await getCollection('lots');
  return lots.map((lot) => ({ params: { slug: lot.id }, props: { lot } }));
}) satisfies GetStaticPaths;

const { lot } = Astro.props;
---

<LotPage lot={lot} locale="es" />
