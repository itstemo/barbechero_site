---
/**
 * `02 — EL LUGAR`'s map (plan §4).
 *
 * A static base map of southern Mexico (`src/assets/map-base.svg`, generated
 * once by `design/map-src.html`) with one accent marker for this lot and a
 * dimmed context dot for every other lot, so a reader sees where this lot sits
 * among the rest. Positions are computed at build time by `src/lib/projection.ts`
 * from each place's `coords`; no percentage is hardcoded, and nothing in this
 * component runs in the browser.
 *
 * The base map is inlined rather than `<img src>`-ed, for the same reason
 * <Logo> is: its strokes are `currentColor`, so the coastline is ink on paper
 * in light mode and the same relationship inverted in dark mode. Served as a
 * file it would keep whatever colour was baked into it and disappear against
 * the dark ground.
 *
 * One marker, at the *palenque* — plan §3b "DECIDED": a lot's field and its
 * still can be different places (Telixtac and Pachivia are 8.6km apart), but
 * at this scale that is 3.35px against an 11px dot, so two markers would
 * overlap into a blob. The distinction is carried by the prose and the
 * ORIGEN / PALENQUE spec rows instead.
 */
import { getCollection, getEntries, getEntry, type CollectionEntry } from 'astro:content';
import mapBase from '../assets/map-base.svg?raw';
import {
  MAP_ASPECT_RATIO,
  formatPercent,
  isOnMap,
  project,
  type MapPosition,
} from '../lib/projection';
import { placeLabel, lotLocality } from '../lib/lot';
import type { Locale } from '../i18n/routes';
import { t, ui } from '../i18n/ui';

interface Props {
  lot: CollectionEntry<'lots'>;
  locale: Locale;
  /**
   * Accessible name override. Defaults to a sentence in `locale` naming the
   * palenque's locality (plan §6 item 6 — never the generic "map of southern
   * Mexico").
   */
  alt?: string;
  class?: string;
}

const { lot, locale, alt, class: className }: Props = Astro.props;

// Resolve eagerly and check: Astro reports a dangling reference through the
// logger without failing the build, so a missing join would otherwise surface
// as a render-time crash on `.data` (plan §3c).
const [origin, palenque] = await Promise.all([
  getEntry(lot.data.origin),
  getEntry(lot.data.palenque),
]);
if (!origin) {
  throw new Error(
    `LotMap: lot "${lot.id}" references an origin ("${lot.data.origin.id}") that could not be resolved.`,
  );
}
if (!palenque) {
  throw new Error(
    `LotMap: lot "${lot.id}" references a palenque ("${lot.data.palenque.id}") that could not be resolved.`,
  );
}

// Same rule as the landing row, the lot hero and the OG card (plan §3b): the
// pin sits at the palenque, but the caption names both places when they
// differ — the origin plainly, the palenque with its full label.
const caption = lotLocality(origin, palenque).toUpperCase();

/*
 * Context dots for every *other* lot, derived from the collection — a fourth
 * lot gets a fourth dot with no edit here. Keyed by place id so two lots
 * sharing a palenque produce one dot, and so a sibling that happens to be
 * distilled at this lot's own palenque is not drawn underneath the marker.
 */
const otherLots = (await getCollection('lots')).filter((entry) => entry.id !== lot.id);
const siblingPlaces = await getEntries(otherLots.map((entry) => entry.data.palenque));
const seen = new Set<string>([palenque.id]);
const siblings: MapPosition[] = [];
for (const place of siblingPlaces) {
  if (!place || seen.has(place.id)) continue;
  seen.add(place.id);
  const position = project(place.data.coords);
  // A place outside the cropped map would be drawn hanging off the edge.
  if (isOnMap(position)) siblings.push(position);
}

const marker = project(palenque.data.coords);
const markerLeft = formatPercent(marker.x);
const markerTop = formatPercent(marker.y);

/*
 * A `below` label is drawn 2.2 line-heights under the pin, so a marker low in
 * the frame pushes its caption out of the map and into the credit line — which
 * is exactly what happened to the two Oaxaca lots (La Chaga sits at 76.3% of
 * the frame's height) on every phone-width viewport.
 *
 * A caption that has to wrap to two lines needs `y·H + 2.2L + 2L <= H`, i.e.
 * `y <= 1 - 4.2L/H`, to stay inside the frame. The tightest case the site
 * renders is a 360px viewport: the frame is 320px wide, so H = 320 * 280/660 =
 * 136px, and L (--mono-2xs at --lh-flat) is 12px — giving 62%. Beyond that the
 * caption is flipped above the pin at narrow widths (see the stylesheet); it
 * grows upward into the map instead of downward out of it. Wide viewports keep
 * the placement the design specified, because there the caption is one line and
 * fits below.
 */
const LOW_MARKER_THRESHOLD = 62;
const isLowMarker = marker.y > LOW_MARKER_THRESHOLD;

const label = placeLabel(palenque);
const altText =
  alt ??
  (siblings.length > 0
    ? t(ui.map.altAmongSiblings, locale, label)
    : t(ui.map.alt, locale, label));
---

<figure
  class:list={['lot-map', className]}
  style={`--accent-hue:${lot.data.accentHue};--map-aspect-ratio:${MAP_ASPECT_RATIO}`}
>
  <div class="lot-map__frame" role="img" aria-label={altText}>
    {/* Decorative: the frame above carries the role and the label. */}
    <div class="lot-map__base" aria-hidden="true" set:html={mapBase} />
    {
      siblings.map((sibling) => (
        <span
          class="lot-map__sibling"
          aria-hidden="true"
          style={`left:${formatPercent(sibling.x)};top:${formatPercent(sibling.y)}`}
        />
      ))
    }
    <span
      class="lot-map__ring"
      aria-hidden="true"
      style={`left:${markerLeft};top:${markerTop}`}></span>
    <span
      class="lot-map__pin"
      aria-hidden="true"
      style={`left:${markerLeft};top:${markerTop}`}></span>
    <span
      class:list={[
        'lot-map__label',
        `is-${palenque.data.labelPlacement}`,
        isLowMarker && 'is-low',
      ]}
      aria-hidden="true"
      style={`--x:${markerLeft};top:${markerTop}`}
    >
      {caption}
    </span>
  </div>
  <figcaption class="lot-map__credit">{t(ui.map.credit, locale)}</figcaption>
</figure>

<style>
  .lot-map {
    /* `--accent` is substituted where it is *declared* — at `:root` — so
       setting `--accent-hue` on this figure would not on its own change the
       inherited colour. Redeclaring it here rebinds the hue locally, which
       keeps the map correct whether or not the surrounding page has already
       set `--accent-hue` on `:root`. Same L and C as tokens.css by
       construction; the hue is still the only per-lot number. */
    --accent: oklch(var(--accent-l) var(--accent-c) var(--accent-hue));

    margin: 0;
    max-width: 100%;
  }

  .lot-map__frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--map-aspect-ratio);
  }

  .lot-map__base {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* `:global` because `set:html` content is injected verbatim and never
     receives this component's scope class. */
  .lot-map__base :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* All three overlays are centred on their own coordinate via a negative
     margin of half their size, so `left`/`top` stay pure projection output. */
  .lot-map__pin,
  .lot-map__ring,
  .lot-map__sibling {
    position: absolute;
    border-radius: 50%;
  }

  .lot-map__pin {
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--paper-halo);
  }

  .lot-map__ring {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border: 1px solid var(--accent);
    opacity: 0.55;
  }

  .lot-map__sibling {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--ink);
    opacity: 0.3;
  }

  /* The label spans the full width and is centred by asymmetric padding
     rather than by `translateX(-50%)`. Both put its centre at --x, but this
     way the text is bounded by the map instead of hanging off the page when
     a long caption sits near an edge (plan §6b item 1: nothing may overflow
     at 360px). */
  .lot-map__label {
    position: absolute;
    left: 0;
    right: 0;
    padding-left: max(0px, calc(2 * var(--x) - 100%));
    padding-right: max(0px, calc(100% - 2 * var(--x)));
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    font-size: var(--mono-2xs);
    line-height: var(--lh-flat);
    letter-spacing: var(--track-sm);
    color: var(--ink);
    /* A caption placed above its pin crosses the coastline and, on the Oaxaca
       lots, the Guerrero context dots. The same paper halo the pin carries
       keeps it readable over them, in either mode. */
    text-shadow:
      0 0 4px var(--paper-halo),
      0 0 4px var(--paper-halo);
  }

  /* Matches the design's translate(-50%,-260%) / (-50%,220%) — but measured in
     *line boxes* rather than in percentages of the label's own height, which is
     what those percentages resolved against. For the one-line caption the
     design was drawn with the two are identical (-260% = -100% - 1.6 lines,
     220% = 2.2 lines); for a caption that wraps to two lines the percentage
     version doubled the gap and threw the label clear of the map, so the
     distance from the pin now stays put as the caption grows. */
  .lot-map__label {
    --label-line: calc(1em * var(--lh-flat));
  }

  .lot-map__label.is-above {
    transform: translateY(calc(-100% - 1.6 * var(--label-line)));
  }

  .lot-map__label.is-below {
    transform: translateY(calc(2.2 * var(--label-line)));
  }

  /* Below the two-column breakpoint the map is narrow enough that a long
     caption must be allowed to wrap rather than run past the frame. */
  @media (max-width: 899px) {
    .lot-map__label {
      white-space: normal;
      text-wrap: balance;
    }

    /* ...and narrow enough that a caption hung below a low marker would land on
       top of the credit line. `.is-low` is set at build time (see above) for
       exactly the markers where that happens; those flip above the pin, growing
       into the map rather than out of it. */
    .lot-map__label.is-below.is-low {
      transform: translateY(calc(-100% - 1.6 * var(--label-line)));
    }
  }

  .lot-map__credit {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--mono-3xs);
    line-height: 1.7;
    letter-spacing: var(--track-sm);
    color: var(--faint);
  }
</style>
