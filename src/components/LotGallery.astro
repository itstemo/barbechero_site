---
/**
 * A captioned photo strip — a small process essay that doesn't fit the
 * single per-section `images.*` slot (see `gallery` on the lots schema).
 * Full width wherever the section is two-up; below that it becomes an inset
 * 260px strip so portrait photos do not dominate the reading flow.
 *
 * That switch is at 746px, not the design's 900px: `.section__grid` is
 * `auto-fit minmax(330px, 1fr)` with `--gap-grid`, so it collapses to one
 * column at 2*330 + 0.05W > W - 48, i.e. below 745.3px. Capping at 900px
 * instead left a single 260px file of photos sitting in a 752px content box
 * next to a still-two-column section.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  items: GalleryItem[];
}

const { items }: Props = Astro.props;
---

<div class="lot-gallery">
  {
    items.map((item) => (
      <figure class="lot-gallery__item">
        <Picture
          src={item.image}
          alt={item.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[260, 320, 480, 640, 780]}
          sizes="(min-width: 1280px) 250px, (min-width: 1240px) calc(298px - 3.75vw), (min-width: 998px) calc(21.25vw - 12px), (min-width: 746px) calc(30vw - 16px), 260px"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{item.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .lot-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: var(--gap-grid);
  }

  /* Once the section is a single column, inset the strip so a process
     sequence does not become a full-width wall of portrait photos. See the
     header comment for why this is 745px and not 900px. */
  @media (max-width: 745px) {
    .lot-gallery {
      max-width: 260px;
    }
  }

  .lot-gallery__item {
    margin: 0;
    min-width: 0;
  }

  .lot-gallery__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .lot-gallery__item figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    line-height: var(--lh-body);
    letter-spacing: var(--track-sm, 0.02em);
    color: var(--muted-strong);
  }
</style>
