---
/**
 * A captioned photo strip — a small process essay that doesn't fit the
 * single per-section `images.*` slot (see `gallery` on the lots schema).
 * Full width: spans both grid tracks of the section it's dropped into via
 * `.section__gallery` in LotPage.astro, regardless of column count.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  items: GalleryItem[];
}

const { items }: Props = Astro.props;
---

<div class="lot-gallery">
  {
    items.map((item) => (
      <figure class="lot-gallery__item">
        <Picture
          src={item.image}
          alt={item.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[320, 480, 640]}
          sizes="(min-width: 700px) 320px, 45vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{item.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .lot-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--gap-grid);
  }

  .lot-gallery__item {
    margin: 0;
    min-width: 0;
  }

  .lot-gallery__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .lot-gallery__item figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    line-height: var(--lh-body);
    letter-spacing: var(--track-sm, 0.02em);
    color: var(--muted-strong);
  }
</style>
