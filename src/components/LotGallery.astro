---
/**
 * A captioned photo strip — a small process essay that doesn't fit the
 * single per-section `images.*` slot (see `gallery` on the lots schema).
 * Full width on desktop; below the two-column breakpoint it becomes an inset
 * process strip so portrait photos do not dominate the reading flow.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  items: GalleryItem[];
}

const { items }: Props = Astro.props;
---

<div class="lot-gallery">
  {
    items.map((item) => (
      <figure class="lot-gallery__item">
        <Picture
          src={item.image}
          alt={item.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[260, 320, 480, 640, 780]}
          sizes="(min-width: 1280px) 250px, (min-width: 1240px) calc(298px - 3.75vw), (min-width: 998px) calc(21.25vw - 12px), (min-width: 900px) calc(30vw - 16px), 260px"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{item.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .lot-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--gap-grid);
  }

  /* Match the main lot media's inset treatment below the two-column
     breakpoint. This keeps a process sequence from becoming a full-width
     wall of portrait photos on a phone. */
  @media (max-width: 899px) {
    .lot-gallery {
      max-width: 260px;
    }
  }

  .lot-gallery__item {
    margin: 0;
    min-width: 0;
  }

  .lot-gallery__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .lot-gallery__item figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: var(--mono-xs);
    line-height: var(--lh-body);
    letter-spacing: var(--track-sm, 0.02em);
    color: var(--muted-strong);
  }
</style>
