---
/**
 * The one layout: <head>, the sticky header, and the footer.
 *
 * Nav (plan §6 defect 2): the prototype hardcodes every lot as a top-level nav
 * item. That fits at three and wraps into a mess at eight. The nav here is
 * fixed-size — INICIO / LOTES (N) — and the lot list lives on the landing page,
 * so it costs the same width at 3 lots as at 30. The count is derived from the
 * collection, so a new lot changes the header without a template edit.
 */
import { getCollection } from 'astro:content';
import Logo from '../components/Logo.astro';
import {
  HTML_LANG,
  OG_LOCALE,
  alternatePaths,
  otherLocale,
  pagePath,
  type Locale,
  type PageRef,
} from '../i18n/routes';

import { t, ui } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Which language this page is written in. Drives every string below. */
  locale: Locale;
  /**
   * What this page *is*, independent of locale. The language toggle and the
   * hreflang pairs are computed from it, so the toggle lands on the same
   * page in the other language rather than on the home page.
   */
  page: PageRef;
  /** Which nav item is the current page. Lot pages are "lotes". */
  nav?: 'inicio' | 'lotes';
  /**
   * Per-lot accent hue. Applied on <body>, so the header, footer and every
   * link on a lot page pick up that lot's colour. One number per lot — never
   * a hex, never a colour table (plan §1).
   */
  accentHue?: number;
  /**
   * Root-relative path to this page's Open Graph card, drawn at build time by
   * src/pages/og/[slug].png.ts. Defaults to the site-wide card.
   */
  ogImage?: string;
  /** Alternative text for the card, for the platforms that expose it. */
  ogImageAlt?: string;
  /** JSON-LD, already shaped. Emitted verbatim in a script[type=ld+json]. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  locale,
  page,
  nav,
  accentHue,
  ogImage = '/og/site.png',
  ogImageAlt,
  jsonLd,
}: Props = Astro.props;

// Only the count is needed; the list itself belongs to the landing page.
const lotCount = (await getCollection('lots')).length;

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin);
/* Absolute, because og:image is one of the few tags that genuinely requires
   it — most scrapers will not resolve a relative path. */
const ogImageUrl = new URL(ogImage, origin);

/*
 * hreflang. Derived from `page`, so every page advertises its counterpart —
 * not just the home page — and x-default points at Spanish, which is what
 * serves from `/` (astro.config.mjs `defaultLocale`).
 */
const alternates = alternatePaths(page);
const hreflang = [
  { lang: 'es', href: new URL(alternates.es, origin).href },
  { lang: 'en', href: new URL(alternates.en, origin).href },
  { lang: 'x-default', href: new URL(alternates.es, origin).href },
];

const other = otherLocale(locale);
const homeHref = pagePath({ kind: 'home' }, locale);
const lotsHref = `${homeHref}#lotes`;
const aboutHref = pagePath({ kind: 'about' }, locale);
const cardAlt = ogImageAlt ?? t(ui.meta.homeOgAlt, locale);
---

<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      hreflang.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
      ))
    }

    {/*
      Icons. The artwork is the logo mark on a paper tile, generated from the
      same path set as <Logo>. The tile is deliberate: an ink mark on a
      transparent ground disappears against a dark browser chrome.
      SVG is preferred by modern browsers; the .ico is the bare-/favicon.ico
      fallback older clients request without being told to.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Kept in sync with the resolved theme by the script below. The value
        here is the light ground, which is what a client that ignores the
        script (or runs with it disabled) will correctly show. */}
    <meta name="theme-color" content="#f7f5ee" id="theme-color" />

    {/*
      The only client script on the site, and the reason it exists: a theme
      chosen on the last visit has to be on <html> *before the first paint*,
      or the reader gets a flash of the other theme on every navigation.
      Nothing else can do that — not a stylesheet, not a deferred module.

      So it is deliberately the smallest thing that works: read one key, set
      one attribute, and stamp `data-theme-ready` so the toggle button can
      reveal itself (a control that cannot work without JavaScript should not
      be visible when there is none). `is:inline` keeps it in the document
      rather than becoming a blocking request, which would defeat the point.

      No stored choice means no attribute, which means `prefers-color-scheme`
      decides — the OS setting is the default, not light.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var chosen = null;
        try {
          chosen = localStorage.getItem('barbechero-theme');
        } catch (error) {
          /* Private mode, or storage disabled. Fall through to the OS. */
        }
        if (chosen === 'light' || chosen === 'dark') {
          root.setAttribute('data-theme', chosen);
        }
        root.setAttribute('data-theme-ready', '');

        var dark =
          chosen === 'dark' ||
          (chosen !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        /* Same two grounds as src/styles/tokens.css. */
        document
          .getElementById('theme-color')
          .setAttribute('content', dark ? '#191511' : '#f7f5ee');
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Barbechero" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cardAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={cardAlt} />

    <meta name="generator" content={Astro.generator} />

    {/* is:inline is explicit: this is structured data, not code. It must reach
        the page verbatim and must never be picked up by the bundler, which
        would turn the site's only <script> element into a JS asset. */}
    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {/* The two faces used above the fold, per src/styles/fonts.css. */}
    <link
      rel="preload"
      href="/fonts/spectral-300i.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plexmono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body style={accentHue === undefined ? undefined : `--accent-hue:${accentHue}`}>
    <a class="skip-link u-mono" href="#contenido">{t(ui.nav.skipToContent, locale)}</a>

    <header class="site-header">
      <div class="site-header__bar u-page">
        <a
          class="site-header__brand"
          href={homeHref}
          aria-label={t(ui.nav.ariaBrand, locale)}
        >
          <Logo variant="mark" class="site-header__mark" />
          <Logo variant="word" class="site-header__word" />
        </a>

        <nav class="site-nav" aria-label={t(ui.nav.ariaMain, locale)}>
          <a
            class="site-nav__link"
            href={homeHref}
            aria-current={nav === 'inicio' ? 'page' : undefined}
            >{t(ui.nav.home, locale)}</a
          >
          <span class="site-nav__divider" aria-hidden="true"></span>
          <a
            class="site-nav__link"
            href={lotsHref}
            aria-current={nav === 'lotes' ? 'page' : undefined}
            >{t(ui.nav.lots, locale)}<span class="site-nav__count">{lotCount}</span></a
          >
          <span class="site-nav__divider" aria-hidden="true"></span>

          {/*
            The language toggle. Two plain <a href>, no script — a language
            switcher is a navigation, so a link is the correct control, and it
            keeps working with JavaScript off. (The theme toggle below is the
            one control on the site that cannot be built this way; see the
            note in <head>.)

            Both hrefs come from `alternatePaths(page)`, i.e. from what this
            page *is*, so /en/lot/gro-em-26/ points at /lote/gro-em-26/ and
            back. `hreflang` and `lang` on each link tell a screen reader and
            a crawler what is on the other end; `aria-current="true"` marks
            the one you are already reading.
          */}
          <span class="site-lang" role="group" aria-label={t(ui.nav.ariaLanguage, locale)}>
            <a
              class="site-nav__link site-lang__link"
              href={alternates.es}
              hreflang="es"
              lang="es"
              aria-label={t(ui.nav.ariaLangEs, locale)}
              aria-current={locale === 'es' ? 'true' : undefined}
              >{t(ui.nav.langEs, locale)}</a
            >
            <span class="site-lang__slash" aria-hidden="true">/</span>
            <a
              class="site-nav__link site-lang__link"
              href={alternates.en}
              hreflang="en"
              lang="en"
              aria-label={t(ui.nav.ariaLangEn, locale)}
              aria-current={locale === 'en' ? 'true' : undefined}
              >{t(ui.nav.langEn, locale)}</a
            >
          </span>

        </nav>

        <span class="site-nav__divider site-nav__divider--theme" aria-hidden="true"></span>

        {/*
          The theme toggle. A <button>, not a link: it changes how this page
          looks, it does not go anywhere.

          Which icon shows is decided in CSS, by the same three-state logic
          as the palette in tokens.css — so the right one is painted on the
          first frame, with no script involved. The button shows the mode it
          will move you *to*: a moon on paper, a sun in the dark.

          The label has to say the same thing, and CSS cannot write one, so
          both strings ride along in data-* and the script picks. Until it
          does, `aria-label` is the neutral "Theme".
        */}
        <button
          type="button"
          class="site-nav__link site-theme"
          data-label-dark={t(ui.nav.themeToDark, locale)}
          data-label-light={t(ui.nav.themeToLight, locale)}
          aria-label={t(ui.nav.ariaTheme, locale)}
        >
          {/* Drawn to sit with the Instagram glyph in the footer: one
              stroke weight, currentColor, no fill. */}
          <svg
            class="site-theme__icon site-theme__icon--sun"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
          >
            <circle cx="12" cy="12" r="4.6" />
            <path
              d="M12 1.9v2.6M12 19.5v2.6M22.1 12h-2.6M4.5 12H1.9M19.14 4.86l-1.84 1.84M6.7 17.3l-1.84 1.84M19.14 19.14L17.3 17.3M6.7 6.7L4.86 4.86"
            />
          </svg>
          <svg
            class="site-theme__icon site-theme__icon--moon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
          >
            <path d="M20.5 14.6A9 9 0 1 1 9.4 3.5a7.2 7.2 0 0 0 11.1 11.1Z" />
          </svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer__bar u-page">
        <div class="site-footer__brand">
          <Logo variant="word" label="Barbechero" class="site-footer__word" />
          <span class="site-footer__tagline">{t(ui.footer.tagline, locale)}</span>
          {/*
            Not in the header nav (plan §6b already tunes that row to the
            edge of what fits at 360px with the language toggle in it — a
            third item risks the exact horizontal-overflow class of bug this
            site is built to catch). The footer has room to spare.
          */}
          <a class="site-footer__link u-mono" href={aboutHref}>{t(ui.footer.about, locale)}</a>
          {/* The Instagram glyph is drawn (not an <img>): one stroke weight,
              currentColor ink, no fill — it sits with the hairlines and mono
              type instead of importing the platform's gradient brand. The
              handle text keeps the row at the 44px tap floor. */}
          <a
            class="site-footer__link site-footer__social u-mono"
            href="https://www.instagram.com/barbechero"
            rel="me"
            aria-label={t(ui.footer.instagramAria, locale)}
          >
            <svg
              class="site-footer__social-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
            >
              <rect x="2.75" y="2.75" width="18.5" height="18.5" rx="5.25" />
              <circle cx="12" cy="12" r="4.25" />
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
            </svg>
            @barbechero
          </a>
        </div>
        <p class="site-footer__legal">
          {t(ui.footer.origin, locale)}<br />{t(ui.footer.warning, locale)}
        </p>
      </div>
    </footer>

    {/*
      The other half of the toggle. Down here rather than in <head> because
      nothing it does needs to happen before paint — the palette and the icon
      are already correct by then; this only handles the press.

      `is:inline` for the same reason as the head script: a separate request
      for twenty lines is worse than the twenty lines.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var button = document.querySelector('.site-theme');
        var meta = document.getElementById('theme-color');
        var system = window.matchMedia('(prefers-color-scheme: dark)');
        if (!button) return;

        /* What is actually on screen: the chosen theme if there is one, and
           the OS setting if there is not. Both the label and the meta tag
           follow from this, never from the stored value alone. */
        function resolved() {
          var chosen = root.getAttribute('data-theme');
          if (chosen === 'dark' || chosen === 'light') return chosen;
          return system.matches ? 'dark' : 'light';
        }

        function sync() {
          var dark = resolved() === 'dark';
          button.setAttribute(
            'aria-label',
            dark ? button.dataset.labelLight : button.dataset.labelDark,
          );
          meta.setAttribute('content', dark ? '#191511' : '#f7f5ee');
        }

        button.addEventListener('click', function () {
          var next = resolved() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('barbechero-theme', next);
          } catch (error) {
            /* The choice still holds for this page; it just will not persist. */
          }
          sync();
        });

        /* Someone flipping their OS theme while the page is open, with no
           choice stored here, should follow along. */
        system.addEventListener('change', sync);

        sync();
      })();
    </script>
  </body>
</html>

<style is:global>
  /* `--accent` is substituted where it is declared (`:root` in tokens.css), so
     re-setting `--accent-hue` further down the tree has no effect unless
     `--accent` is redeclared there too. Redeclaring it once on <body> makes the
     per-lot inline `--accent-hue` above govern the whole page. Same L and C as
     tokens.css by construction; the hue stays the only per-lot number. */
  body {
    --accent: oklch(var(--accent-l) var(--accent-c) var(--accent-hue));
  }
</style>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 50;
    font-size: var(--mono-xs);
    letter-spacing: var(--track-md);
    background: var(--paper);
    border: 1px solid var(--ink);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 16px;
  }

  .skip-link:focus {
    left: 8px;
    top: 8px;
  }

  /* --- Header ----------------------------------------------------------- */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper-header);
    border-bottom: 1px solid var(--rule);
  }

  /* blur is expensive on low-end Android and the ground is already 92%
     opaque, so it is an enhancement, not the fallback (plan §6b item 14). */
  @supports (backdrop-filter: blur(6px)) or (-webkit-backdrop-filter: blur(6px)) {
    .site-header {
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
  }

  /* The bar is pinned to --header-h (minus its own 1px border) rather than
     being whatever its contents happen to measure, so --sticky-top, which is
     derived from --header-h, is correct by construction (plan §6b item 4).
     Contents are at most 44px tall (the tap-target floor), which fits. */
  .site-header__bar {
    min-height: calc(var(--header-h) - 1px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    flex: 0 1 auto;
    min-width: 0;
  }

  .site-header__brand :global(.site-header__mark) {
    height: 26px;
    width: auto;
    flex: none;
  }

  /* The design's fixed 132px wordmark plus the nav does not fit at 360px;
     it scales down to 96px there and reaches the design width by ~508px. */
  .site-header__brand :global(.site-header__word) {
    width: clamp(96px, 26vw, 132px);
    height: auto;
    flex: none;
  }

  /* The bar's three groups. Explicit `order` because the toggle changes
     rows at 640px — see the two-row rule at the bottom of this block — and
     `order` is the only way to move it there without a second copy in the
     markup. `margin-left: auto` (not the bar's `space-between`, which would
     spread three children evenly) keeps the nav and the toggle together on
     the right, with the brand alone on the left. */
  .site-nav {
    order: 2;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 22px);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--mono-xs);
    line-height: var(--lh-flat);
    letter-spacing: var(--track-md);
    flex: none;
  }

  /* Pad the control rather than enlarging the type (plan §6b item 6).
     `min-width` as well as `min-height`: the tap floor is 44px in both
     directions, and a short label ("HOME", "EN") is narrower than that at
     any mono size the scale allows. */
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: var(--tap);
    min-width: var(--tap);
    padding-inline: 2px;
    opacity: 0.62;
    white-space: nowrap;
  }

  .site-nav__link[aria-current='page'] {
    opacity: 1;
  }

  @media (hover: hover) {
    .site-nav__link:hover {
      opacity: 1;
    }
  }

  .site-nav__link:active,
  .site-nav__link:focus-visible {
    opacity: 1;
  }

  .site-nav__count {
    font-size: var(--mono-3xs);
    letter-spacing: var(--track-sm);
    color: var(--muted);
  }

  .site-nav__count::before {
    content: '(';
  }

  .site-nav__count::after {
    content: ')';
  }

  .site-nav__divider {
    width: 1px;
    height: 12px;
    background: var(--rule-strong);
    flex: none;
  }

  /* --- Language toggle --------------------------------------------------- */

  .site-lang {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
  }

  /* Each face is its own control, so each needs the full 44px target, not
     just the pair together (plan §6b item 6). */
  .site-lang__link {
    padding-inline: 0;
  }

  .site-lang__link[aria-current='true'] {
    opacity: 1;
  }

  .site-lang__slash {
    color: var(--rule-strong);
  }

  /* --- Theme toggle ------------------------------------------------------ */

  /* Hidden until the head script has run. Without JavaScript the palette
     still follows the OS correctly — there is simply nothing to press, and
     a dead control is worse than no control. */
  .site-theme,
  .site-nav__divider--theme {
    display: none;
  }

  :root[data-theme-ready] .site-theme {
    display: inline-flex;
  }

  :root[data-theme-ready] .site-nav__divider--theme {
    display: block;
  }

  .site-nav__divider--theme {
    order: 3;
  }

  /* Same 44px target as every other control in this bar (plan §6b item 6).
     `padding-inline: 0` because the icon is already centred in it. */
  .site-theme {
    order: 4;
    flex: none;
    padding-inline: 0;
  }

  .site-theme__icon {
    width: 15px;
    height: 15px;
    flex: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The button offers the mode you are *not* in: a moon on paper, a sun in
     the dark. The three states below mirror the palette in tokens.css
     exactly — system default, chosen dark, chosen light — so the icon and
     the ground can never disagree, including on the first painted frame. */
  .site-theme__icon--sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .site-theme__icon--sun {
      display: block;
    }

    :root:not([data-theme='light']) .site-theme__icon--moon {
      display: none;
    }
  }

  :root[data-theme='dark'] .site-theme__icon--sun {
    display: block;
  }

  :root[data-theme='dark'] .site-theme__icon--moon {
    display: none;
  }

  /* Two rows below 640px: brand, then nav. At 360px the bar has ~176px left
     after the brand and INICIO / LOTES alone needs ~163px of it, so the
     toggle cannot share that row without overflowing. --header-h is set to
     match in tokens.css, so the sticky offsets stay correct. */
  @media (max-width: 639px) {
    .site-header__bar {
      flex-wrap: wrap;
      align-content: center;
      row-gap: 4px;
    }

    .site-nav {
      flex: 1 0 100%;
      /* It owns the whole row now, so it neither needs pushing right nor
         can it come before the toggle. */
      order: 3;
      margin-left: 0;
    }

    /* Up to the brand row. INICIO / LOTES / ES / EN already needs ~163px of
       the ~176px this row has spare at 360px; a fourth control on it
       overflows by ~40px, which is the exact failure the nav was reshaped to
       avoid. The brand row has the space, and "top right" is where the
       control belongs anyway. */
    .site-theme {
      order: 2;
    }

    /* The divider separated it from the language pair. On its own row above,
       the edge of the bar does that job. */
    :root[data-theme-ready] .site-nav__divider--theme {
      display: none;
    }
  }

  /* --- Footer ----------------------------------------------------------- */

  .site-footer {
    border-top: 1px solid var(--ink);
    margin-top: 20px;
  }

  .site-footer__bar {
    padding-block: 34px 46px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__brand :global(.site-footer__word) {
    width: min(150px, 60vw);
    height: auto;
  }

  .site-footer__tagline {
    font-style: italic;
    font-size: var(--serif-sm);
